# Neon (serverless Postgres) — the only database secret.
# Get it from the Neon dashboard: Connection Details > Connection string.
# The app builds and runs without this set (dashboard shows baked sample data).
NEON_DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# FastRouter (Claude API) — enables receipt OCR and the CFO chat.
# Live features show a friendly "add a key" state when this is missing.
FASTROUTER_API_KEY=your-fastrouter-api-key-here
